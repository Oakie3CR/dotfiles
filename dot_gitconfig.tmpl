# vim:ft=cfg sw=2 ts=2 et
[alias]
  ci = commit
  co = checkout
  create-pull-request = !sh -c 'stash pull-request $0'
  default = ! git remote show origin | sed -n '/HEAD branch/s/.*: //p'
  diffall = difftool --dir-diff
  diffsplit = -c delta.side-by-side=true diff
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  fpush = push --force-with-lease
  rlog = log --date=relative
  root = !pwd
  st = status
  top = rev-parse --show-toplevel

[branch]
  autosetuprebase = always

[clean]
  requireForce = false

[color]
  ui = auto

[commit]
  gpgsign = true

[core]
  autocrlf = input
  safecrlf = warn
  editor = nvim
  excludesFile = {{ .chezmoi.homeDir -}}/.gitignore_global
  pager = delta
  synlinks = true

[credential]
  helper = osxkeychain

[delta]
  syntax-theme = Monokai Extended Bright
  line-numbers = true
  navigate = true
  #inspect-raw-lines = false

[delta "interactive"]
  keep-plus-minus-markers = true

[diff]
  tool = bc
  compactionHeuristic = true
  colorMoved = default

[difftool "bc"]
  trustExitCode = true

[fetch]
  prune = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process

[filter "media"]
  clean = git-media filter-clean
  smudge = git-media filter-smudge

[gpg]
  format = ssh

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = /Users/christian.rigdon/.ssh/allowed_signers
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[help]
  autocorrect = 10

[hook "hk-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || hk run commit-msg --from-hook \"$@\"
	event = commit-msg
[hook "hk-post-checkout"]
	command = test \"${HK:-1}\" = \"0\" || hk run post-checkout --from-hook \"$@\"
	event = post-checkout
[hook "hk-post-commit"]
	command = test \"${HK:-1}\" = \"0\" || hk run post-commit --from-hook \"$@\"
	event = post-commit
[hook "hk-post-merge"]
	command = test \"${HK:-1}\" = \"0\" || hk run post-merge --from-hook \"$@\"
	event = post-merge
[hook "hk-post-rewrite"]
	command = test \"${HK:-1}\" = \"0\" || hk run post-rewrite --from-hook \"$@\"
	event = post-rewrite
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || hk run pre-commit --from-hook \"$@\"
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || hk run pre-push --from-hook \"$@\"
	event = pre-push
[hook "hk-pre-rebase"]
	command = test \"${HK:-1}\" = \"0\" || hk run pre-rebase --from-hook \"$@\"
	event = pre-rebase
[hook "hk-prepare-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || hk run prepare-commit-msg --from-hook \"$@\"
	event = prepare-commit-msg

[init]
  defaultBranch = main
  templateDir = ~/.git-template-empty

[interactive]
  diffFilter = delta --color-only --features=interactive

# reference: https://www.scootersoftware.com/kb/vcs#gitlinux
[merge]
  tool = bc

[mergetool]
  keepBackup = false

[mergetool "bc"]
  trustExitCode = true

[push]
  default = upstream

# [remote "origin"] # This make it so get keeps up with tags, but it also breaks homebrew HEAD apps
#   tagopt = --tags
#   pruneTags = true

[rebase]
  updateRefs = true

[rerere]
  enabled = true

[tag]
  sort = version:refname

[user]
  name = Christian Rigdon
  email = {{ .email }}
{{ if .work }}
  signingkey = {{ onepasswordRead "op://private/Work Key/public key" }}
{{ else }}
  signingkey = {{ onepasswordRead "op://private/Home Key/public key" }}
{{- end }}
